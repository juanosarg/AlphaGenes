	<AbilityDef>
		<defName>AG_EyeProjectile</defName>
		<label>eye</label>
		<description>It's better not to think too hard about this.</description>
		<iconPath>Things/Projectile/AG_EyeProjectile</iconPath>
		<cooldownTicksRange>180</cooldownTicksRange>
		<aiCanUse>true</aiCanUse>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
		<writeCombatLog>True</writeCombatLog>
		<verbProperties>
			<verbClass>Verb_AbilityShoot</verbClass>
			<defaultProjectile>AG_EyeProjectile</defaultProjectile>
